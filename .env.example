# Public project configuration
NEXT_PUBLIC_PROJECT_NAME=Corner CoWorks
NEXT_PUBLIC_PROJECT_LOCATION=Bhopal, Madhya Pradesh
NEXT_PUBLIC_PROJECT_TAGLINE=Building the future. Creating possibilities.
NEXT_PUBLIC_CONTACT_PHONE=+91XXXXXXXXXX
NEXT_PUBLIC_CONTACT_EMAIL=info@example.com

# Supabase - create a project at https://supabase.com
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Email notifications - Resend https://resend.com
RESEND_API_KEY=re_xxxxxxxxx
NOTIFICATION_EMAIL=leads@example.com
EMAIL_FROM=Corner CoWorks Website <leads@your-verified-domain.com>

# WhatsApp Cloud API - Meta Developer dashboard
WHATSAPP_ACCESS_TOKEN=YOUR_META_PERMANENT_ACCESS_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_WHATSAPP_PHONE_NUMBER_ID
WHATSAPP_ADMIN_NUMBER=91XXXXXXXXXX
WHATSAPP_TEMPLATE_NAME=new_lead_notification
WHATSAPP_TEMPLATE_LANGUAGE=en

# Optional: IP geolocation. The app uses ipapi.co if available.
# Set false to disable third-party IP geolocation lookups.
ENABLE_IP_GEOLOCATION=true

# Admin dashboard - create this user in Supabase Authentication > Users
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
ADMIN_EMAIL=admin@example.com
